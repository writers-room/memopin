{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "메모핀",
  "version": "0.1.0",
  "identifier": "com.writersroom.memopin",
  "mainBinaryName": "memopin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5175",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/writers-room/memopin/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3MDlFNkU1Q0UxNDVDN0QKUldSOVhCVE81ZVlKeHp4bk1GRnlDemhpL1hUdzhTUmRBM2hJWHZxUzRTbkhIQ2pCeWovVW5MTVgK"
    }
  },
  "app": {
    "windows": [
      {
        "label": "box",
        "title": "메모핀",
        "width": 940,
        "height": 600,
        "minWidth": 640,
        "minHeight": 420,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "메모핀"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Korean"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "publisher": "writers-room"
  }
}
